#!/usr/bin/env bash
# Change localhost and facebook.com IP addresses
set -e
tmp_file=$(mktemp)
sed -e 's/^127\.0\.0\.1[[:space:]]\+localhost/127.0.0.2 localhost/' \
    -e '/[[:space:]]facebook\.com\([[:space:]]\|$\)/d' /etc/hosts > "$tmp_file"
echo "8.8.8.8 facebook.com" >> "$tmp_file"
cat "$tmp_file" > /etc/hosts
rm "$tmp_file"
